{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed web audit MCP request envelopes and structuredContent responses",
  "$comment": "Design only. Extract <tool>Input as inputSchema and <tool>Success|ErrorResult as outputSchema, resolving local refs. Semantic policy, budgets, oracle truth and revision/state relationships require runtime enforcement. Native screenshot ImageContent is outside this JSON structure. Reply serialization must enforce the wire byte budget; null snapshot values indicate provisioning did not seal the snapshot.",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Response"
    }
  ],
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "Handle": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "AuditState": {
      "enum": [
        "queued",
        "provisioning",
        "ready",
        "exploring",
        "testing",
        "finalizing",
        "completed",
        "partial",
        "cancelled",
        "interrupted",
        "failed"
      ]
    },
    "Category": {
      "enum": [
        "authz_read",
        "xss_reflected_dom",
        "business_invariant",
        "other"
      ]
    },
    "Mutation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field_ref": {
          "$ref": "#/$defs/Handle"
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fixture_ref": {
                  "$ref": "#/$defs/Handle"
                }
              },
              "required": [
                "fixture_ref"
              ]
            }
          ]
        }
      },
      "required": [
        "field_ref",
        "value"
      ]
    },
    "Action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "observe"
            },
            "actor_id": {
              "$ref": "#/$defs/Handle"
            }
          },
          "required": [
            "kind",
            "actor_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "navigate"
            },
            "actor_id": {
              "$ref": "#/$defs/Handle"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^/(?!/)[^\\\\\\u0000]*$"
            }
          },
          "required": [
            "kind",
            "actor_id",
            "path"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "click"
            },
            "actor_id": {
              "$ref": "#/$defs/Handle"
            },
            "element_ref": {
              "$ref": "#/$defs/Handle"
            }
          },
          "required": [
            "kind",
            "actor_id",
            "element_ref"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "fill"
            },
            "actor_id": {
              "$ref": "#/$defs/Handle"
            },
            "element_ref": {
              "$ref": "#/$defs/Handle"
            },
            "value": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": [
            "kind",
            "actor_id",
            "element_ref",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "select"
            },
            "actor_id": {
              "$ref": "#/$defs/Handle"
            },
            "element_ref": {
              "$ref": "#/$defs/Handle"
            },
            "value": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": [
            "kind",
            "actor_id",
            "element_ref",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "replay_request"
            },
            "actor_id": {
              "$ref": "#/$defs/Handle"
            },
            "request_ref": {
              "$ref": "#/$defs/Handle"
            },
            "mutations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Mutation"
              },
              "minItems": 0,
              "maxItems": 16
            }
          },
          "required": [
            "kind",
            "actor_id",
            "request_ref",
            "mutations"
          ]
        }
      ]
    },
    "CaseStep": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "observe"
            },
            "actor_id": {
              "$ref": "#/$defs/Handle"
            }
          },
          "required": [
            "kind",
            "actor_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "navigate"
            },
            "actor_id": {
              "$ref": "#/$defs/Handle"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^/(?!/)[^\\\\\\u0000]*$"
            }
          },
          "required": [
            "kind",
            "actor_id",
            "path"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "click"
            },
            "actor_id": {
              "$ref": "#/$defs/Handle"
            },
            "control_ref": {
              "$ref": "#/$defs/Handle"
            }
          },
          "required": [
            "kind",
            "actor_id",
            "control_ref"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "fill"
            },
            "actor_id": {
              "$ref": "#/$defs/Handle"
            },
            "control_ref": {
              "$ref": "#/$defs/Handle"
            },
            "value": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": [
            "kind",
            "actor_id",
            "control_ref",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "select"
            },
            "actor_id": {
              "$ref": "#/$defs/Handle"
            },
            "control_ref": {
              "$ref": "#/$defs/Handle"
            },
            "value": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": [
            "kind",
            "actor_id",
            "control_ref",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "replay_request"
            },
            "actor_id": {
              "$ref": "#/$defs/Handle"
            },
            "template_ref": {
              "$ref": "#/$defs/Handle"
            },
            "mutations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Mutation"
              },
              "minItems": 0,
              "maxItems": 16
            }
          },
          "required": [
            "kind",
            "actor_id",
            "template_ref",
            "mutations"
          ]
        }
      ]
    },
    "CasePlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/Category"
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "actor_id": {
          "$ref": "#/$defs/Handle"
        },
        "resource_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Handle"
            },
            {
              "type": "null"
            }
          ]
        },
        "oracle_id": {
          "anyOf": [
            {
              "enum": [
                "authz_read_isolation_v1",
                "xss_nonce_execution_v1",
                "business_invariant_v1"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline_observation_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "minItems": 1,
          "maxItems": 10
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Handle"
          },
          "minItems": 0,
          "maxItems": 10
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CaseStep"
          },
          "minItems": 1,
          "maxItems": 20
        },
        "effects": {
          "type": "array",
          "items": {
            "enum": [
              "network_read",
              "fixture_write"
            ]
          },
          "minItems": 1,
          "maxItems": 2
        }
      },
      "required": [
        "category",
        "hypothesis",
        "actor_id",
        "resource_ref",
        "oracle_id",
        "baseline_observation_ids",
        "source_refs",
        "steps",
        "effects"
      ]
    },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/Uuid"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "role": {
          "enum": [
            "baseline",
            "control",
            "attack",
            "repeat",
            "cleanup",
            "source"
          ]
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "role"
      ]
    },
    "ActionView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "$ref": "#/$defs/Uuid"
        },
        "client_action_id": {
          "$ref": "#/$defs/Uuid"
        },
        "status": {
          "enum": [
            "prepared",
            "dispatched",
            "completed",
            "failed",
            "outcome_unknown"
          ]
        },
        "observation_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "minItems": 0,
          "maxItems": 20
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "minItems": 0,
          "maxItems": 20
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "action_id",
        "client_action_id",
        "status",
        "observation_ids",
        "artifact_ids",
        "reason"
      ]
    },
    "CaseView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "$ref": "#/$defs/Uuid"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "status": {
          "enum": [
            "candidate",
            "confirmed",
            "rejected",
            "inconclusive",
            "skipped"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 0,
          "maxItems": 40
        }
      },
      "required": [
        "case_id",
        "category",
        "status",
        "reason",
        "evidence"
      ]
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "$ref": "#/$defs/Uuid"
        },
        "actor_id": {
          "$ref": "#/$defs/Handle"
        },
        "identity_verified": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "dom_excerpt": {
          "type": "string",
          "maxLength": 32768
        },
        "element_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Handle"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "control_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Handle"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "request_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Handle"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "template_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Handle"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Handle"
          },
          "minItems": 0,
          "maxItems": 20
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "minItems": 0,
          "maxItems": 20
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "observation_id",
        "actor_id",
        "identity_verified",
        "path",
        "dom_excerpt",
        "element_refs",
        "control_refs",
        "request_refs",
        "template_refs",
        "source_refs",
        "artifact_ids",
        "truncated"
      ]
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eligible_cases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "confirmed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "rejected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "candidate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "inconclusive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "uninspected_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 200
        }
      },
      "required": [
        "eligible_cases",
        "confirmed",
        "rejected",
        "candidate",
        "inconclusive",
        "skipped",
        "uninspected_reasons"
      ]
    },
    "Budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "integer",
          "minimum": 0
        },
        "http_requests": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_read": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "source_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "stopped_by": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "actions",
        "http_requests",
        "bytes_read",
        "elapsed_ms",
        "source_bytes",
        "artifact_bytes",
        "stopped_by"
      ]
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/Handle"
        },
        "profile_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "snapshot_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "fixture_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "source_files": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 5000
            },
            {
              "type": "null"
            }
          ]
        },
        "excluded_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 200
        }
      },
      "required": [
        "profile_id",
        "profile_hash",
        "snapshot_hash",
        "fixture_version",
        "source_files",
        "excluded_reasons"
      ]
    },
    "Runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "$ref": "#/$defs/Handle"
        },
        "image_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "enum": [
            "preparing",
            "ready",
            "unavailable",
            "stopped",
            "unknown"
          ]
        },
        "authentication": {
          "enum": [
            "available",
            "unavailable",
            "not_started"
          ]
        }
      },
      "required": [
        "adapter_id",
        "image_digest",
        "status",
        "authentication"
      ]
    },
    "Cleanup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pending",
            "verified",
            "failed"
          ]
        },
        "resource_manifest_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "resource_manifest_hash",
        "reason"
      ]
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "$ref": "#/$defs/Uuid"
        },
        "case_id": {
          "$ref": "#/$defs/Uuid"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "status": {
          "const": "confirmed"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info",
            "unknown"
          ]
        },
        "oracle_id": {
          "$ref": "#/$defs/Handle"
        },
        "oracle_version": {
          "type": "integer",
          "minimum": 1
        },
        "profile_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "snapshot_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "actor_id": {
          "$ref": "#/$defs/Handle"
        },
        "resource_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Handle"
            },
            {
              "type": "null"
            }
          ]
        },
        "fixture_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "expected": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "observed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 0,
          "maxItems": 20
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Handle"
          },
          "minItems": 0,
          "maxItems": 10
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 2,
          "maxItems": 40
        },
        "replay_steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CaseStep"
          },
          "minItems": 1,
          "maxItems": 20
        },
        "source_localized": {
          "type": "boolean"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "finding_id",
        "case_id",
        "category",
        "status",
        "severity",
        "oracle_id",
        "oracle_version",
        "profile_hash",
        "snapshot_hash",
        "actor_id",
        "resource_ref",
        "fixture_version",
        "expected",
        "observed",
        "conditions",
        "source_refs",
        "evidence",
        "replay_steps",
        "source_localized",
        "verified_at"
      ]
    },
    "Limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_wall_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1200000
        },
        "action_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15000
        },
        "case_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "actions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "http_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        },
        "cases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "steps_per_case": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "source_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "artifact_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
